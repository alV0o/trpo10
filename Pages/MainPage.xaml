<Page x:Class="trpo10.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo10.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Label Content="Введите процессор"/>
                <TextBox Text="{Binding CurrentComputer.CPU, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Введите объем ОЗУ"/>
                <TextBox Text="{Binding CurrentComputer.RAM, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Введите объем SSD"/>
                <TextBox Text="{Binding CurrentComputer.SSD, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Введите видеокарту"/>
                <TextBox Text="{Binding CurrentComputer.GraphicsCard, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Сохранить" Click="SaveConfiguration_Click"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Label Content="Выбранный элемент"/>
                <TextBlock>
                    <Run Text="CPU: "/>
                    <Run Text="{Binding SelectedComputer.CPU}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="RAM: "/>
                    <Run Text="{Binding SelectedComputer.RAM}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="SSD: "/>
                    <Run Text="{Binding SelectedComputer.SSD}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Видеокарта: "/> 
                    <Run Text="{Binding SelectedComputer.GraphicsCard}"/>
                </TextBlock>
                <Button Content="Дублировать" Click="Duplicate_Click"/>
            </StackPanel>
        </DockPanel>

        <ListView Grid.Column="1" ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Margin="10" Background="LightGray">
                        <TextBlock>
                        <Run Text="CPU: "/>
                        <Run Text="{Binding CPU}"/>
                        </TextBlock>
                        <TextBlock>
                        <Run Text=" RAM: "/>
                        <Run Text="{Binding RAM}"/>
                        </TextBlock>
                        <TextBlock>
                        <Run Text=" SSD: "/>
                        <Run Text="{Binding SSD}"/>
                        </TextBlock>
                        <TextBlock>
                        <Run Text=" Видеокарта: "/>
                        <Run Text="{Binding GraphicsCard}"/>
                        </TextBlock>
                    </WrapPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
